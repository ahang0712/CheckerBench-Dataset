+static int append_strings(char buf[], size_t bufsize, int argc, char *argv[])
+{
+	int i;
+	int len;
+
+	// Check input length
+	len = 0;
+	for (i = 0; i < argc; ++i) {
+		len += 1 + strlen(argv[i]);
+		if(len >= bufsize) {
+			return EXIT_FAILURE;
+		}
+	}
+
+	// Concatenate strings
+	buf[0] = '\0';
+	for (i = 0; i < argc; ++i) {
+		if (i) {
+			strcat(buf, " ");
+		}
+		strcat(buf, argv[i]);
+	}
+	strcat(buf, "\n");
+
+	return EXIT_SUCCESS;
+}
